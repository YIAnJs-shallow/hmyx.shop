Options -Indexes
<FilesMatch "(?i)^(?:\.env(?:\..*)?|.*\.(?:sql|zip|log|md|ini))$">
    Require all denied
</FilesMatch>
# 根地址直接展示商城首页（welcome.php 新人落地页仍可直接访问）
DirectoryIndex welcome.php index.php index.html

RewriteEngine On
# 隐藏文件/目录默认禁止（.git/.github/.cursor 等）；仅保留证书与平台验证常用的 .well-known 通道
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule ^(?:backup_[^/]+|config|lib|scripts|tests|\.claude|\.codex|\.agents)(?:/|$) - [F,L]
